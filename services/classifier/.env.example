# Groq API key - https://console.groq.com (free, 14,400 req/day, no credit card)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PostgreSQL connection string
# When running via docker-compose, host = service name "postgres"
DATABASE_URL=postgresql://signalstock:signalstock_dev@localhost:5432/signalstock

# Redis connection string
# When running via docker-compose, host = service name "redis"
REDIS_URL=redis://localhost:6379

# BRPOP timeout in seconds
BRPOP_TIMEOUT=10
