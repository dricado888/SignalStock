# Finlight API key - https://finlight.me/
FINLIGHT_API_KEY=your_finlight_key_here

# NewsAPI key - https://newsapi.org/
NEWSAPI_KEY=your_newsapi_key_here

# PostgreSQL connection string
# When running via docker-compose, host = service name "postgres"
DATABASE_URL=postgresql://signalstock:signalstock_dev@postgres:5432/signalstock

# Redis connection string
# When running via docker-compose, host = service name "redis"
REDIS_URL=redis://redis:6379

# How often to poll for new articles (seconds). Default: 300 (5 minutes)
POLL_INTERVAL_SECONDS=300

# ── Twitter / Apify (optional) ──────────────────────────────────────────────
# Leave APIFY_API_TOKEN blank to disable Twitter scraping entirely.
#
# Get your token at: https://apify.com → Settings → Integrations → API token
# Free tier: $5/month credits (~1,000 actor runs)
APIFY_API_TOKEN=

# Comma-separated Twitter handles to scrape (no @ prefix)
# Recommended: mix of financial news, company official accounts, regulators
TWITTER_ACCOUNTS=Reuters,WSJ,FT,GoldmanSachs,SECGov,FederalReserve,elonmusk,nytimesbusiness,nvidia,OpenAI,AnthropicAI,Apple

# How often to re-scrape Twitter (seconds). Default: 21600 (6 hours)
# Twitter scraping is slower and more expensive than news APIs — keep this high.
TWITTER_POLL_INTERVAL_SECONDS=21600

# Maximum tweets to fetch per account per run. Default: 10
TWITTER_MAX_TWEETS_PER_ACCOUNT=10
