# JWT secret — change to a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# Finnhub API key — https://finnhub.io (free tier: 60 req/min)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# PostgreSQL connection string
# When running via docker-compose, host = service name "postgres"
DATABASE_URL=postgresql://signalstock:signalstock_dev@localhost:5432/signalstock

# Redis connection string
# When running via docker-compose, host = service name "redis"
REDIS_URL=redis://localhost:6379
