# SendGrid API key
# Sign up free at https://sendgrid.com — 100 emails/day, no credit card
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender email (must be verified in SendGrid dashboard)
# Settings > Sender Authentication > Single Sender Verification
SENDGRID_FROM_EMAIL=noreply@signalstock.com

# PostgreSQL connection string
# When running via docker-compose, host = service name "postgres"
DATABASE_URL=postgresql://signalstock:signalstock_dev@localhost:5432/signalstock

# Seconds to sleep between alert polls (default: 60)
POLL_INTERVAL=60

# Max alert rows to process per poll (default: 50)
BATCH_SIZE=50
