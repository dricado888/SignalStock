# SignalStock — root .env reference
# Each service has its own .env file. Copy the per-service examples:
#
#   cp services/scraper/.env.example    services/scraper/.env
#   cp services/classifier/.env.example services/classifier/.env
#   cp services/mapper/.env.example     services/mapper/.env
#   cp services/alerts/.env.example     services/alerts/.env
#   cp services/api/.env.example        services/api/.env
#
# Then fill in your API keys in each file.

# ── News Sources ─────────────────────────────────────────────────────────────
FINLIGHT_API_KEY=your_finlight_key_here       # https://finlight.me (10K req/month free)
NEWSAPI_KEY=your_newsapi_key_here             # https://newsapi.org (100 req/day free)
APIFY_API_TOKEN=                              # https://apify.com — leave blank to skip Twitter

# ── AI Classification ─────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxx                    # https://console.groq.com (free, no credit card)

# ── Stock Data ───────────────────────────────────────────────────────────────
FINNHUB_API_KEY=your_finnhub_key_here        # https://finnhub.io (60 req/min free)

# ── Email Alerts ──────────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxx                     # https://sendgrid.com (100 emails/day free)
SENDGRID_FROM_EMAIL=noreply@yourdomain.com   # Must be verified in SendGrid dashboard

# ── Infrastructure ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://signalstock:signalstock_dev@localhost:5432/signalstock
REDIS_URL=redis://localhost:6379
